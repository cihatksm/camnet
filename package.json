{
  "name": "camnet",
  "version": "1.1.0",
  "private": true,
  "description": "Local network camera sharing and OBS streaming server",
  "author": "cihatksm",
  "license": "MIT",
  "homepage": "https://github.com/cihatksm/camnet#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cihatksm/camnet.git"
  },
  "bugs": {
    "url": "https://github.com/cihatksm/camnet/issues"
  },
  "keywords": [
    "camera",
    "webrtc",
    "obs",
    "lan",
    "mjpeg",
    "streaming",
    "svelte",
    "pwa",
    "electron"
  ],
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "node server/index.js",
    "serve": "npm run build && node server/index.js",
    "smoke": "node scripts/smoke.mjs",
    "server:watch": "node --watch server/index.js",
    "icons": "node scripts/gen-icons.mjs",
    "electron": "electron .",
    "dist:win": "node scripts/gen-icons.mjs && npm run build && electron-builder --win portable"
  },
  "dependencies": {
    "express": "^4.22.3",
    "qrcode": "^1.5.4",
    "selfsigned": "^2.4.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "electron": "^37.10.3",
    "electron-builder": "^26.18.0",
    "svelte": "^5.57.2",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "build": {
    "appId": "net.camnet.app",
    "productName": "CamNet",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "server/**/*",
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "icon": "public/icons/icon-512.png",
      "requestedExecutionLevel": "requireAdministrator",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "CamNet.exe"
    }
  },
  "allowScripts": {
    "electron@37.10.3": true,
    "electron-winstaller@5.4.0": true
  }
}